{
  "name": "@heartstone/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HeartStone design tokens: brand palette, semantic themes, type, spacing and CSS custom properties.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@heartstone/config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
