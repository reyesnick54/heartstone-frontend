{
  "name": "@heartstone/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HeartStone same-origin gateway for the app Workers: OIDC Authorization Code + PKCE sign-in, encrypted session cookie, and the /api proxy to the backend. Web-standard APIs only.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@heartstone/api-client": "workspace:*"
  },
  "devDependencies": {
    "@heartstone/config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
