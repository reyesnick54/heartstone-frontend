{
  "name": "@heartstone/citizen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HeartStone citizen and resident web experience (mobile-first).",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "preview:worker": "vite build && wrangler dev",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@heartstone/api-client": "workspace:*",
    "@heartstone/gateway": "workspace:*",
    "@heartstone/tokens": "workspace:*",
    "@heartstone/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@heartstone/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  }
}
