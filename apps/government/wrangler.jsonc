{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heartstone-government",
  "compatibility_date": "2026-09-24",
  // Single-page app plus the HeartStone gateway (packages/gateway). Only /api/* and /auth/* run
  // the Worker; everything else is a static asset, and unknown paths serve index.html.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"],
  },
  // Gateway variables and secrets are set per environment in the Cloudflare dashboard
  // (docs/deployment.md, "Gateway"). keep_vars stops a deploy from erasing dashboard variables.
  "keep_vars": true,
  // workers.dev and Preview URLs are enabled during the design build so reviewers have a URL
  // before a custom domain exists. Both MUST sit behind Cloudflare Access (docs/deployment.md).
  // Set workers_dev to false once the approved custom domain is attached.
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  // Staging: synthetic data only, behind Cloudflare Access. Deployed by
  // .github/workflows/deploy-staging.yml (docs/deployment.md, "Staging"). SESSION_COOKIE_KEY is
  // a Worker secret generated by that workflow; it is never in git.
  "env": {
    "staging": {
      "name": "heartstone-government-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging-gov.heartstone.site", "custom_domain": true }],
      "vars": {
        "BACKEND_ORIGIN": "https://heartstone-api-staging-0r4k.onrender.com",
        "OIDC_ISSUER": "https://heartstone-keycloak-staging-0r4k.onrender.com/realms/heartstone",
        "OIDC_CLIENT_ID": "heartstone-web",
        "OIDC_PROVIDER_CODE": "heartstone-keycloak",
        "OIDC_REDIRECT_URI": "https://staging-gov.heartstone.site/auth/callback",
      },
    },
    // ABSEZ deployment on absez.org. Deployed by .github/workflows/deploy-absez.yml
    // (docs/deployment.md, "absez.org"). Uses the same Render backend and Keycloak as staging
    // until a production backend exists; SESSION_COOKIE_KEY is a separate Worker secret.
    "absez": {
      "name": "heartstone-government-absez",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "gov.absez.org", "custom_domain": true }],
      "vars": {
        "BACKEND_ORIGIN": "https://heartstone-api-staging-0r4k.onrender.com",
        "OIDC_ISSUER": "https://heartstone-keycloak-staging-0r4k.onrender.com/realms/heartstone",
        "OIDC_CLIENT_ID": "heartstone-web",
        "OIDC_PROVIDER_CODE": "heartstone-keycloak",
        "OIDC_REDIRECT_URI": "https://gov.absez.org/auth/callback",
      },
    },
  },
}
